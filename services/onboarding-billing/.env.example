# ============================================
# onboarding-billing-service - Variables de entorno
# ============================================

# ------ Supabase (obligatorias) ------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ------ Multi-tenant (obligatorias) ------
NEXT_PUBLIC_TENANT_BASE_DOMAIN=godcode.me
NEXT_PUBLIC_TENANT_PROTOCOL=https

# ------ URL pública de la app (obligatoria) ------
# Obligatoria detrás de Coolify, también como argumento de build: sin ella los enlaces de los correos y los regresos de PayPal y Mercado Pago caen al dominio base o a localhost.
NEXT_PUBLIC_APP_URL=https://www.godcode.me

# ------ Auth inter-servicio (obligatoria) ------
SERVICE_API_KEY=your-shared-secret-between-bff-and-this-service

# ------ PayPal (pagos PayPal) ------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox

# ------ Mercado Pago (alta en Chile, cobra en CLP) ------
# Access Token de la aplicación: el de prueba en local, el de producción en Coolify.
MERCADOPAGO_ACCESS_TOKEN=

# ------ Tasa BCV (montos en bolívares del alta y de los pagos de /cuenta) ------
# La tasa sale de la tabla exchange_rates, la misma de la tienda: el servicio la lee y guarda las nuevas con la función record_exchange_rate, con la clave de service role de arriba. Hace falta la migración 20261007_exchange_rates.sql en la base; sin ella consulta dolarapi directo.
# Respaldo manual opcional, en bolívares por dólar: solo se usa si fallan la tabla y dolarapi. Vacío: sin tasa, el monto en bolívares no se muestra.
BCV_RATE=

# ------ Resend (emails transaccionales) ------
RESEND_API_KEY=re_...
# "Gcode POS <hola@tu-dominio>" (sin nombre se antepone el del producto)
RESEND_FROM=noreply@godcode.me

# ------ reCAPTCHA (onboarding) ------
# Clave secreta de reCAPTCHA v3 (la del sitio, NEXT_PUBLIC_RECAPTCHA_SITE_KEY, va en la app). Vacía = el alta no se verifica: solo para desarrollo.
RECAPTCHA_SECRET_KEY=
# Puntaje mínimo de reCAPTCHA v3 (0 a 1) para aceptar el registro. Vacío = 0.5.
RECAPTCHA_MIN_SCORE=

# ------ Upstash Redis (recomendada con más de una instancia) ------
# API REST de Upstash: límites de intentos y contadores del cron compartidos entre instancias. Sin ella cada proceso cuenta por su lado.
UPSTASH_REDIS_REST_URL=
# Token de esa base de Upstash. Va junto con la URL: sin uno de los dos, cada proceso cuenta por su lado.
UPSTASH_REDIS_REST_TOKEN=

# ------ Cron jobs ------
CRON_SECRET=
# Tiendas sin publicar («Arma y paga»): on | dry-run (por defecto) | off. Sin on no se borran a los 30 días ni sale el aviso de los 23.
STORE_DRAFT_PURGE=

# ------ Revalidación de la tienda en la app ------
# Mismo valor que REVALIDATION_SECRET de la app. Sin él, la tienda recién pagada sigue en «abre pronto» hasta 5 min.
REVALIDATION_SECRET=

# ------ Avisos por Telegram al equipo (opcional) ------
# Token del bot (de @BotFather) y chat o grupo donde escribe. Sin alguno de los dos no se manda nada.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------ Emails de equipo (vacío = correo de soporte) ------
ONBOARDING_TEAM_EMAIL=

# ------ Correos (opcional) ------
# La marca sale de lib/landing/brand (Gcode POS / Gcode Labs).
EMAIL_LOGO_URL=
EMAIL_REPLY_TO=
# Recordatorios del cron: on (por defecto) | dry-run | off
EMAIL_REMINDERS=
EMAIL_REMINDERS_MAX_PER_RUN=

# ------ Dev: saltar verificacion de correo ------
# 1/true/on: el alta queda como email_verified y NO se envia correo.
# Debe quedar vacio en produccion.
ONBOARDING_SKIP_EMAIL_VERIFICATION=
