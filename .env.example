# Landing footer — usuario de Instagram o URL completa (https://instagram.com/tucuenta)
NEXT_PUBLIC_LANDING_INSTAGRAM_URL="https://www.instagram.com/gcode.labs/"
# Landing footer y schema Organization.sameAs — página de empresa (URL completa o slug: gcode-labs)
NEXT_PUBLIC_LANDING_LINKEDIN_URL="https://www.linkedin.com/company/gcode-labs/"
# Landing footer — número con código país o URL wa.me (https://wa.me/56912345678)
NEXT_PUBLIC_LANDING_WHATSAPP_URL="56943848080"
# PayPal cobra el alta (servicio onboarding-billing) y los pagos de /cuenta (esta app): mismas credenciales en ambos.
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
# sandbox | production (sin valor o sandbox =""
PAYPAL_ENVIRONMENT=""
# Id del webhook creado en PayPal (Developer > Apps > Webhooks) apuntando a
# <app>/api/payments/paypal/webhook con el evento PAYMENT.CAPTURE.COMPLETED.
# Sin él el webhook responde 503 y no aplica nada (falla cerrado).
PAYPAL_WEBHOOK_ID=""
# Mercado Pago (Chile, CLP) cobra el alta en el paso de pago. Access Token de la aplicación
# (Tus integraciones): el de prueba en local, el de producción en Coolify. Mismo valor aquí y
# en el servicio onboarding-billing. Ver docs/guias/mercado-pago-checkout-pro.md.
MERCADOPAGO_ACCESS_TOKEN=""
# Clave secreta del webhook (Webhooks > Configurar notificaciones) apuntando a
# <app>/api/payments/mercadopago/webhook con el evento "Órdenes (Mercado Pago)".
# Sin ella el webhook responde 503 y no aplica nada (falla cerrado). Solo en esta app.
MERCADOPAGO_WEBHOOK_SECRET=""
RESEND_API_KEY=""
# «Mi menú» en /cuenta: leer la carta del dueño (foto, PDF o Excel). Sin clave la opción no aparece.
ANTHROPIC_API_KEY=""
# Opcional: cambiar el modelo que lee las cartas.
MENU_IMPORT_MODEL=""
# Remitente: "Gcode POS <hola@tu-dominio>" (sin nombre se antepone el del producto)
RESEND_FROM=""
RECAPTCHA_SECRET_KEY=""
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
HEALTH_CHECK_SECRET=""
CRON_SECRET=""
# Bandeja del equipo (solicitudes nuevas, comprobantes por validar). Vacío = correo de soporte.
ONBOARDING_TEAM_EMAIL=""
ONBOARDING_CONTACT_DAYS=""
ONBOARDING_MAX_DELIVERIES_PER_DAY=""
# Correos: logo (PNG cuadrado; por defecto <app>/logo.png) y a dónde van las respuestas
EMAIL_LOGO_URL=""
EMAIL_REPLY_TO=""
# Recordatorios automáticos del cron (vencimientos, pagos sin completar, altas a medias):
# on (por defecto) | dry-run (calcula y no manda) | off
EMAIL_REMINDERS=""
EMAIL_REMINDERS_MAX_PER_RUN=""
# Tiendas sin publicar («Arma y paga»): on | dry-run (por defecto) | off. Sin on no se borran a los 30 días ni sale el aviso de los 23.
STORE_DRAFT_PURGE=""
FF_ONBOARDING_BILLING_EXTERNAL=""
ONBOARDING_BILLING_SERVICE_URL=""
