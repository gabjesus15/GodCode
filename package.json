    "@radix-ui/react-dialog": "^1.1.15",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "@swc/helpers": "^0.5.21",
    "@tanstack/react-query": "^5.101.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "currency.js": "^2.0.4",
    "dompurify": "^3.4.2",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.38.0",
    "i18n-iso-countries": "^7.14.0",
    "leaflet": "^1.9.4",
    "lightningcss": "^1.32.0",
    "lucide-react": "^1.14.0",
    "next": "^16.2.6",
    "next-intl": "^4.11.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.75.0",
    "react-simple-maps": "^3.0.0",
    "recharts": "^3.9.0",
    "rut.js": "^2.1.0",
    "server-only": "^0.0.1",
    "sileo": "^0.1.5",
    "sonner": "^2.0.7",
    "stripe": "^22.1.1",
    "tailwind-merge": "^3.5.0",
    "topojson-client": "^3.1.0",
    "vaul": "^1.1.2",
    "world-atlas": "^2.0.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
