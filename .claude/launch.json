{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "dev-account",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "cross-env",
        "NEXT_PUBLIC_MENU_ACCOUNT_ENABLED=1",
        "next",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "dev-attach",
      "url": "http://localhost:3000",
      "port": 3000
    },
    {
      "name": "panel",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "../GodCode-Panel",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "caja-video",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "../Saas-Godcode-paneladmin-ceo",
        "run",
        "dev",
        "--",
        "--host",
        "127.0.0.1",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173,
      "url": "http://127.0.0.1:5173"
    },
    {
      "name": "onboarding-billing",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--workspace",
        "onboarding-billing-service"
      ],
      "port": 3001
    }
  ]
}
