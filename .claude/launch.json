{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "dev-attach",
      "url": "http://localhost:3000",
      "port": 3000
    },
    {
      "name": "panel",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "../GodCode-Panel",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "onboarding-billing",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--workspace",
        "onboarding-billing-service"
      ],
      "port": 3001
    }
  ]
}
