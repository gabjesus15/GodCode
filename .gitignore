# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.pnpm-store
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem

# scratch / local one-off dumps
/_tmp/

# debug & logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
.next/dev/logs/

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Scripts super-admin (Telegram pairing / watermark local)
/scripts/.cache/

# vercel
.vercel

# Nested Next.js microservice (onboarding-billing)
services/onboarding-billing/node_modules/
services/onboarding-billing/.next/

# typescript
*.tsbuildinfo
next-env.d.ts

# editor / IDE (optional: remove if you want to commit shared settings)
.cursor/
.turbo
