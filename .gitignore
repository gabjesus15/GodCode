# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.pnpm-store
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem

# scratch / local one-off dumps
/_tmp/
/Claude outputs/

# debug & logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
.next/dev/logs/

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Scripts super-admin (Telegram pairing / watermark local)
/scripts/.cache/

# vercel
.vercel

# Nested Next.js microservice (onboarding-billing)
services/onboarding-billing/node_modules/
services/onboarding-billing/.next/

# typescript
*.tsbuildinfo
next-env.d.ts

# editor / IDE (optional: remove if you want to commit shared settings)
.cursor/
.turbo
.idea/
*.swp
*~
.eslintcache

# Claude Code: ajustes personales y worktrees locales (launch.json sí se comparte)
.claude/settings.local.json
.claude/worktrees/

# MCP local (apunta a una IP privada)
.mcp.json

# Lo que no es parte de la app no entra al proyecto (lo pidió el dueño):
# - herramientas de diseño con IA (Impeccable) y su contexto;
.impeccable/
/DESIGN.md
/PRODUCT.md
# - migraciones y SQL: se entregan aparte y el dueño las corre a mano;
migrations/
/docs/
# - material para redes y videos (capturas, posts, PDF y sus scripts).
/*.png
/*.jpg
/*.jpeg
/*.pdf
/*.svg
/*.mp4
/*.gif
scripts/video/
